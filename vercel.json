{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mainstreetai-drab.vercel.app" }],
      "destination": "https://mainstreetai.tools/:path*",
      "permanent": true
    }
  ]
}
